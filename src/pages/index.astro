---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('pages', 'index');

if (!entry) {
  throw new Error('Missing homepage content');
}

const { Content: PageContent } = await render(entry);
const frontmatter = entry.data;
---

<BaseLayout title={frontmatter.title} description={frontmatter.description} active={frontmatter.active}>
  <PageContent />
</BaseLayout>
